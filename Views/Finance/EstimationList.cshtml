@model List<CrmLeadManagement.Controllers.FinanceListRow>

<div class="breadcrumb-row">
    <a asp-controller="Home" asp-action="Index">Home</a><span class="sep">/</span>
    <span class="sep">Finance</span><span class="sep">/</span><span class="current">Estimation List</span>
</div>
<div class="page-head">
    <div>
        <h1>Estimation List</h1>
        <p>All estimations raised across every lead, in one place.</p>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="top"><div class="icon" style="background:var(--brand-100);color:var(--brand-700);"><i class="bi bi-calculator"></i></div></div>
        <div class="val">@Model.Count</div>
        <div class="lbl">Total Estimations</div>
    </div>
    <div class="stat-card">
        <div class="top"><div class="icon" style="background:#fef6e7;color:#b25e09;"><i class="bi bi-send"></i></div></div>
        <div class="val">@Model.Count(r => r.Status == "Sent")</div>
        <div class="lbl">Sent</div>
    </div>
    <div class="stat-card">
        <div class="top"><div class="icon" style="background:#eafaf0;color:#127a45;"><i class="bi bi-patch-check"></i></div></div>
        <div class="val">@Model.Count(r => r.Status == "Approved")</div>
        <div class="lbl">Approved</div>
    </div>
    <div class="stat-card">
        <div class="top"><div class="icon" style="background:#eef2ff;color:#3538cd;"></div></div>
        <div class="val">@FinanceHelpers.SumTotals(Model.Select(r => r.Total))</div>
        <div class="lbl">Total Value</div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div>
            <h2>All Estimations</h2>
            <div class="hint">@Model.Count estimation(s) found</div>
        </div>
        <div class="filter-bar">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="financeListSearch" onkeyup="filterFinanceTable('estimationTable','financeListSearch')" placeholder="Search by lead, number, email..." />
            </div>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table" id="estimationTable">
            <thead>
                <tr>
                    <th>Lead Name</th>
                    <th>Contact Number</th>
                    <th>Email</th>
                    <th>Estimation Date</th>
                    <th>E-ID</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8"><div class="empty-state"><i class="bi bi-calculator"></i><p>No estimations created yet. Add one from a lead's Finance tab.</p></div></td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="cell-primary">@r.LeadName <div style="font-size:11.5px;color:var(--ink-500);font-weight:400;">@r.CompanyName</div></td>
                        <td>@r.MobileNumber</td>
                        <td>@r.Email</td>
                        <td>@r.Date</td>
                        <td class="cell-primary">@r.Number</td>
                        <td>@FinanceHelpers.Money(r.Total)</td>
                        <td>@Html.Raw(FinanceHelpers.StatusBadge(r.Status))</td>
                        <td>
                            <div style="display:flex;gap:6px;">
                                <a asp-controller="Finance" asp-action="EstimationDetails" asp-route-leadId="@r.LeadId" asp-route-number="@r.Number" class="btn btn-soft btn-sm" title="View">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <form method="post" asp-controller="Finance" asp-action="DeleteEstimation" style="display:inline;" onsubmit="return confirm('Delete estimation @r.Number? This cannot be undone.')">
                                    <input type="hidden" name="leadId" value="@r.LeadId" />
                                    <input type="hidden" name="number" value="@r.Number" />
                                    <button type="submit" class="icon-btn" title="Delete" style="color:#c81e1e;border-color:#fda29b;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterFinanceTable(tableId, inputId) {
            var q = document.getElementById(inputId).value.toLowerCase();
            var rows = document.querySelectorAll('#' + tableId + ' tbody tr');
            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                row.style.display = text.indexOf(q) > -1 ? '' : 'none';
            });
        }
    </script>
}
